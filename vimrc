" 自定义函数
"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" [文件头模板]------------------------------------------------------------------------------------------------------------------------[文件头模板] "
function! SetTitle() abort
  if &filetype == 'sh'
    call setline(1, "#!/bin/bash")
    call append(line("."), "")
  elseif &filetype == 'python'
    call setline(1, "#!/usr/bin/env python3")
    call append(line("."), "# -*- coding: utf-8 -*-")
    call append(line(".")+1, "")
  elseif &filetype == 'go'
    call setline(1, "package main")
    call append(line("."), "")
  elseif expand("%:e") == 'h'
    let l:guard = toupper(expand("%:r")) . "_H_"
    call setline(1, "#ifndef " . l:guard)
    call append(line("."),   "#define " . l:guard)
    call append(line(".")+1, "")
    call append(line(".")+2, "#endif")
  elseif &filetype == 'c'
    call setline(1, "#include <stdio.h>")
    call append(line("."), "")
  elseif expand("%:e") == 'cpp'
    call setline(1, "#include <iostream>")
    call append(line("."), "")
  elseif &filetype == 'java'
    call setline(1, "public class " . expand("%:r") . " {")
    call append(line("."), "}")
  endif
endfunction

" [编译运行]------------------------------------------------------------------------------------------------------------------------------[编译运行] "
function! CompileRun() abort
  exec "w"
  if &filetype == 'c'
    exec "!gcc % -o %< && time ./%<"
  elseif &filetype == 'cpp'
    exec "!g++ % -std=c++11 -o %< && time ./%<"
  elseif &filetype == 'java'
    exec "!javac % && time java %<"
  elseif &filetype == 'sh'
    exec "!time bash %"
  elseif &filetype == 'python'
    exec "!time python3 %"
  elseif &filetype == 'go'
    exec "!time go run %"
  elseif &filetype == 'html'
    exec "!open % &"
  endif
endfunction

" [GDB 调试]--------------------------------------------------------------------------------------------------------------------------------[GDB 调试] "
function! RunGDB() abort
  exec "w"
  if &filetype == 'c'
    exec "!gcc % -g -o %< && gdb ./%<"
  elseif &filetype == 'cpp'
    exec "!g++ % -std=c++11 -g -o %< && gdb ./%<"
  endif
endfunction

